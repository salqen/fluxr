[Unit]
Description=fluxr — Instagram content manager (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fluxr
Group=fluxr
WorkingDirectory=/opt/fluxr/app
EnvironmentFile=/opt/fluxr/.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# --workers 1: scheduler a stav bota žijú v pamäti procesu (viď README)
ExecStart=/opt/fluxr/venv/bin/gunicorn bot_server:app --bind 127.0.0.1:5000 --workers 1 --threads 4 --timeout 120
Restart=always
RestartSec=3

# Hardening — služba smie zapisovať len do vlastných dát
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fluxr/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
